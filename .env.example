# R64-R65 — environment configuration for the laptop runtime.
# Copy this file to `.env` in the repo root, then edit values as needed.
# `scripts/ops/start.ps1` loads this automatically on startup.

# ── Ollama (OCR inference) ────────────────────────────────────────────────
# Point at the desktop PC's Ollama on the LAN. Replace IP with your PC's
# local IP (e.g. 192.168.1.224). On the PC, ensure OLLAMA_HOST=0.0.0.0:11434
# and the Windows firewall allows TCP 11434 inbound on the Private profile.
OLLAMA_URL=http://192.168.1.224:11434
OCR_MODEL=qwen3.5:9b

# Disable Qwen3 reasoning blocks; older Qwen3 tests showed extra thinking
# tokens can hurt JSON stability and latency.
OCR_NO_THINK=1

# Text model for the /learnings LLM analyst (chat + atratores + reports).
# Kept separate from the OCR vision model so the analyst can stay on a
# strong text/chat model (mesmo valor que o OCR por agora, mas knob separado).
OLLAMA_TEXT_MODEL=qwen3.5:9b

# ── Segurança / admin ────────────────────────────────────────────────────
# R256 — Token opcional que protege /admin* e /refs*. Sem valor → aberto
# (comportamento histórico; ver Task C). Definir SEMPRE antes de expor a app
# fora da LAN (o start.ps1 abre um tunnel público trycloudflare).
ADMIN_TOKEN=

# ── Cross-check (motor de scoring) ───────────────────────────────────────
# R256 — variantes do cross engine (R250-R255); ver CLAUDE.md e
# docs/DECISAO_v30cal.md. Defaults em código; só definir para experimentar.
#   CROSS_SCORING_VARIANT   variante ATIVA (default v30 = produção;
#                           v30cal = candidata ao flip R255)
#   CROSS_SHADOW_VARIANT    variante da thread de sombra (default current;
#                           v30cal inicia o soak — triagem em /shadow-queue)
#   CROSS_POSTERIOR_TELEMETRY=0 desliga telemetria do posterior em v30
#   CROSS_POSTERIOR_SWEEP   sweep de calibração (diagnóstico; default off)
#   CROSS_ACTIVE_REREAD     re-leitura ativa de crops no cross (default off)
CROSS_SCORING_VARIANT=v30
CROSS_SHADOW_VARIANT=current
# CROSS_POSTERIOR_TELEMETRY=1
# CROSS_POSTERIOR_SWEEP=0
# CROSS_ACTIVE_REREAD=0

# R256 — gate de gravação por confiança calibrada, limiares sibling-aware.
# LIGAR SÓ COM OK DO LUÍS (caso folha 2367).
# CROSS_WRITE_GATE_MARGINAL=1

# ── Refs & factory paths ─────────────────────────────────────────────────
# These default to `kanban_refs/...` (relative to repo root, tracked
# in git). Change to absolute paths if you want refs outside the repo.

# Where the live StockSAP.xlsx + plan_colunas_cpis.xlsx live.
KANBAN_DOC_DIR=kanban_refs\04_Documentacao

# Where cross_check JSONs are written (read by /sheet/{id} viewer).
CROSS_CHECK_DIR=kanban_refs\03_Cross_Check

# Where validated sheet CSVs are deposited (consumed by the factory's
# kanban_csv2excel_novo_layout.py pipeline).
FACTORY_CSV_DIR=kanban_refs\02_Dados_Extraidos\csv

# ── Google Drive via drive_pull (R267/R268) ──────────────────────────────
# O poller scripts/drive_pull.py (branch feature/drive-pull; tarefa Windows
# registada por scripts\ops\register_drive_pull.ps1) descarrega a pasta
# partilhada 2x/dia: refs -> KANBAN_REFS_IMPORT_DIR (instala o ref_importer
# nativo) e PDFs de «Kanban's MTG2» -> POST /upload (idempotência no poller,
# data/drive_pull_state.json). Ver CLAUDE.md "Portal & ingestão Drive".
#
# Pasta de onde o importador instala os xlsx de referência (StockSAP,
# plan_colunas_cpis, ListaColaboradores, maquinas — nomes livres, a
# classificação é por conteúdo). O drive_pull pousa-os aqui.
# Sem valor -> default F:\ocr\files.
# KANBAN_REFS_IMPORT_DIR=C:\OCR-Suite\drive\refs
# Intervalo do importador em segundos (default 900 = 15 min).
# KANBAN_REFS_IMPORT_INTERVAL_SEC=900
#
# Cópia periódica da data\app.db (ficheiro único "app.db", substituído;
# snapshot também no arranque). Pasta de SAÍDA dedicada — NÃO usar o
# espelho de entrada C:\OCR-Suite\drive; a subida ao Drive é do drive_pull
# (PUSH_FILES). SEM VALOR -> desligado.
# KANBAN_DB_BACKUP_DIR=C:\OCR-Suite\saida
# Intervalo do backup em segundos (default 3600 = 1 h; mínimo 60).
# KANBAN_DB_BACKUP_INTERVAL_SEC=3600
#
# Config do próprio drive_pull (lida pelos wrappers ops; ver branch):
# DRIVE_PULL_MIRROR_TO=C:\OCR-Suite\drive
# DRIVE_PULL_NOTIFY=http://127.0.0.1:8100/ingest/drive;http://127.0.0.1:8101/ingest/drive

# ── Legacy/OpenAI-compatible path ────────────────────────────────────────
# Scripts such as scripts/check_vllm.py use Ollama's /v1 compatibility API.
# Keep this aligned with OCR_MODEL unless you deliberately test another path.
VLLM_URL=http://localhost:11434/v1
VLLM_MODEL=qwen3.5:9b
VLLM_TIMEOUT_S=600
GUIDED_DECODING_ENABLED=false
HF_TOKEN=
# R256 — knobs adicionais do caminho vLLM/JSON (defaults em código):
#   VLLM_MAX_RETRIES     tentativas em erro transitório (default 2)
#   JSON_MODE_ENABLED    força json mode no request (default true)
# VLLM_MAX_RETRIES=2
# JSON_MODE_ENABLED=true

# R256 — pré-processamento OpenCV Fase 0.5. DEFAULT OFF: regrediu -2.6pp em
# VLMs (ver CLAUDE.md anti-patterns). Não ligar sem A/B fresco.
# PREPROCESS_ENABLED=false

# rev01 - Ingestao de PDF de kanbans (scans de MFP do escritorio). Cada pagina
# do PDF vira uma folha independente no pipeline de OCR.
#   PDF_RASTER_DPI    resolucao de rasterizacao (o OCR reduz para <=1288 de
#                     qualquer forma; 200 da folga para o zoom de revisao).
#   PDF_MAX_PAGES     maximo de paginas por PDF (rejeita acima; NAO trunca).
#   PDF_MAX_UPLOAD_MB limite de tamanho do PDF (imagens continuam com 25MB fixo).
#   PDF_ROTATE_DIR    kanbans sao A4 landscape; paginas portrait sao rodadas
#                     para landscape (cw|ccw|none). CALIBRAR com scans reais.
PDF_RASTER_DPI=200
PDF_MAX_PAGES=50
PDF_MAX_UPLOAD_MB=50
PDF_ROTATE_DIR=cw

# R265 — data do kanban. 'dia_util_anterior' (default) ignora o campo Data
# manuscrito e carimba o dia util anterior ao dia do upload; o calendario
# (dias da semana + feriados) edita-se em /admin/calendario e vive em
# data/calendario_util.json. Reverter ao comportamento antigo: 'ocr'.
# KANBAN_DATE_MODE=dia_util_anterior

# Logging
DEBUG=false
LOG_LEVEL=INFO
# R256 — PROFILE_DISABLED=1 desliga o profiling por-request do main.py
# PROFILE_DISABLED=0

# R223 — evitar bytecode .pyc "stale". Garante que o Python recompila sempre o
# .py novo apos um git pull; sem isto, um .pyc antigo em __pycache__ podia fazer
# o processo servir codigo velho mesmo depois de actualizar. O start.ps1 tambem
# apaga __pycache__ e define isto no arranque (cinto e suspensorios).
PYTHONDONTWRITEBYTECODE=1

# Desenvolvimento: DEV_RELOAD=1 faz o start.ps1 arrancar o uvicorn com
# --reload (recarrega sozinho a cada edição de código). NÃO usar em
# produção. Deixar comentado/ausente na Metalogalva.
# DEV_RELOAD=1
