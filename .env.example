# Inference endpoint — OpenAI-compatible Chat Completions API.
#
# Currently running Ollama qwen2.5vl:7b on :11434. We tried vLLM
# 7B-AWQ with llguidance in Docker on Blackwell (RTX 50-series) and
# the worker kept getting SIGINT'd ~30-50 s into init for unknown
# reasons (silent, no error). To switch to vLLM:
#   1) docker compose up -d vllm
#   2) VLLM_URL=http://localhost:8000/v1
#   3) VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
#   4) GUIDED_DECODING_ENABLED=true
VLLM_URL=http://localhost:11434/v1
VLLM_MODEL=qwen2.5vl:7b
VLLM_TIMEOUT_S=600
VLLM_MAX_RETRIES=3

# Set to true only when serving via vLLM. Sends extra_body.guided_json
# to constrain output via llguidance. Ollama errors when this is set.
GUIDED_DECODING_ENABLED=false

# Hugging Face token — irrelevant for Ollama; required only if a vLLM
# pull hits a gated model. Helps avoid HF rate-limits.
HF_TOKEN=

# Logging
DEBUG=false
LOG_LEVEL=INFO
